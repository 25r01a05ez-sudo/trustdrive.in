// TrustDrive India â€” Prisma schema
// Maps directly to the "Database Layer" box in the architecture diagram.
// Works with any Postgres, including Supabase â€” see the README's "Using
// Supabase" section for the two connection strings this schema expects
// (DATABASE_URL for the app, DIRECT_URL for migrations).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Supabase (and other poolers like PgBouncer) need a second, unpooled
  // connection string for running migrations. Local/plain Postgres can set
  // DIRECT_URL to the same value as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

enum Role {
  buyer
  dealer
  admin
}

// Dealer KYC status (whole dealership, set by an admin in the dashboard)
enum VerificationStatus {
  pending
  verified
  rejected
}

// Per-vehicle RC/VAHAN check status (set automatically by the RC lookup)
enum VehicleVerificationStatus {
  pending
  verified
  declined
}

enum VehicleStatus {
  active
  sold
  draft
}

enum LeadChannel {
  call
  whatsapp
  email
}

enum LeadStatus {
  new
  contacted
  closed
}

model User {
  id           String   @id @default(cuid())
  role         Role     @default(buyer)
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  dealerId     String?
  dealer       Dealer?  @relation(fields: [dealerId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([dealerId])
}

model Dealer {
  id                 String             @id @default(cuid())
  name               String
  // GST is now OPTIONAL â€” not every second-hand dealer has GST registration
  gstNumber          String?
  // PAN Card number â€” mandatory for registration
  panNumber          String?
  // Udyam Registration Certificate number â€” mandatory for registration
  udyamNumber        String?
  city               String
  address            String?
  verificationStatus VerificationStatus @default(pending)
  // Rejection reason set by admin when rejecting a dealer application
  rejectionReason    String?
  verifiedAt         DateTime?
  kycDocs            String[]           @default([])
  // Full multi-step dealer-verification wizard payload (business info,
  // owner details, document metadata/previews, bank details, photos,
  // declarations). SENSITIVE â€” contains PAN/Aadhaar/bank details. Never
  // returned from public dealer endpoints; only from admin-only routes.
  // See backend/routes/dealers.js.
  verification       Json?
  // Doubles as the dealer's public contact number (Call button) and their
  // WhatsApp deep-link target for buyer enquiries.
  whatsapp           String?
  rating             Float              @default(0)
  reviewCount        Int                @default(0)

  // --- Listing Credits ---
  // Every dealer gets 5 free approved listings. Once exhausted, they need
  // to purchase a package or pay Rs 1999 per listing individually.
  freeCreditsTotal    Int @default(5)
  freeCreditsUsed     Int @default(0)
  // Credits from purchased packages (Basic/Growth/Pro)
  packageCreditsTotal Int @default(0)
  packageCreditsUsed  Int @default(0)
  // Name of the currently active/last package purchased
  currentPackage      String?

  createdAt          DateTime           @default(now())

  users       User[]
  vehicles    Vehicle[]
  leads       Lead[]
  reviews     Review[]
  site        DealerSite?
  packages    DealerPackage[]
  couponsUsed Coupon[] @relation("CouponUsedBy")

  @@index([city])
  @@index([verificationStatus])
}

// A dealer's own AI-generated microsite, served on its own subdomain
// (e.g. primemotors.trustdrive.in). Content is stored as structured,
// whitelisted fields -- never raw HTML -- so AI-generated text can never
// inject scripts into a page served to the public. See
// backend/lib/aiSiteGenerator.js and backend/routes/dealerSites.js.
model DealerSite {
  id           String   @id @default(cuid())
  dealerId     String   @unique
  dealer       Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  subdomain    String   @unique
  published    Boolean  @default(false)
  lastPrompt   String?
  theme        Json     // { primaryColor, accentColor, font }
  hero         Json     // { headline, subheadline }
  about        Json     // { heading, body }
  highlights   Json     // [{ title, body }]
  contact      Json     // { ctaText }
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([subdomain])
}

model Vehicle {
  id                   String                     @id @default(cuid())
  dealerId             String
  dealer               Dealer                     @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  brand                String
  model                String
  year                 Int
  price                Int
  km                   Int                        @default(0)
  fuel                 String
  transmission         String
  owners               Int                        @default(1)
  chassisNumber        String
  registrationNumber   String
  rcVerified           Boolean                    @default(false)
  verificationStatus   VehicleVerificationStatus  @default(pending)
  // Full VAHAN-style RC lookup result (registration status, engine number,
  // insurance, PUC, financier/hypothecation, RTO, etc.) â€” see
  // backend/lib/rcVerification.js.
  verificationDetails  Json?
  images               String[]                   @default([])
  description          String?
  status               VehicleStatus              @default(active)
  listedAt             DateTime                   @default(now())

  // --- Inspection Video (Admin-only, NEVER exposed publicly) ---
  // Supabase Storage public URL of the uploaded inspection video.
  // Server-side: stripped from ALL non-admin API responses.
  inspectionVideoUrl   String?

  // --- Listing Lifecycle & Payment ---
  // listingStatus tracks the full gated lifecycle:
  //   pending_review â†’ approved_payment_required â†’ active â†’ expired
  //   (or) rejected
  listingStatus        String    @default("pending_review")
  // Payment method used to activate this listing:
  // "unpaid" | "free_credit" | "package_credit" | "paid_individual"
  paymentStatus        String    @default("unpaid")
  // When the listing was activated (payment completed or credit deducted)
  listingActivatedAt   DateTime?
  // 3 months after activation; listing becomes expired after this date
  listingExpiresAt     DateTime?
  // Whether the 3-day-before-expiry reminder email has been sent (avoid duplicates)
  renewalReminderSent  Boolean   @default(false)

  leads Lead[]

  @@index([dealerId])
  @@index([brand, model])
  @@index([status])
  @@index([verificationStatus])
  @@index([listingStatus])
  @@index([listingExpiresAt])
}

// Discount coupons â€” Admin creates, dealers use at payment time
model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  // "percent" = percentage off (e.g. 20 means 20% off)
  // "fixed"   = fixed Rs discount (e.g. 500 means Rs 500 off)
  discountType  String
  discountValue Float
  // When the coupon expires (null = no expiry date)
  expiresAt     DateTime?
  active        Boolean   @default(true)
  // Total usage limit (default 1 = one-time use only)
  usageLimit    Int       @default(1)
  usedCount     Int       @default(0)
  // Which dealer used it (for audit; enforces one-use on backend)
  usedByDealerId String?
  usedByDealer  Dealer?   @relation("CouponUsedBy", fields: [usedByDealerId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())

  @@index([code])
  @@index([active])
}

// Records of package purchases by dealers
model DealerPackage {
  id          String   @id @default(cuid())
  dealerId    String
  dealer      Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  // "starter" (5 free) | "basic" (10, Rs19000) | "growth" (20, Rs39000) | "pro" (50, Rs99000)
  packageName String
  // How many listing credits this package provides
  credits     Int
  // Amount paid in Rs (0 for free/simulated)
  amountPaid  Int
  purchasedAt DateTime @default(now())

  @@index([dealerId])
}

model Lead {
  id         String      @id @default(cuid())
  vehicleId  String
  vehicle    Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  dealerId   String
  dealer     Dealer      @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  buyerName  String
  buyerPhone String
  channel    LeadChannel @default(whatsapp)
  message    String?
  status     LeadStatus  @default(new)
  createdAt  DateTime    @default(now())

  @@index([dealerId])
  @@index([status])
}

model Review {
  id        String   @id @default(cuid())
  dealerId  String
  dealer    Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  buyerName String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@index([dealerId])
}

model Notification {
  id        String   @id @default(cuid())
  dealerId  String
  type      String
  text      String
  createdAt DateTime @default(now())

  @@index([dealerId])
}

model AuditLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  action    String
  userId    String?
  userRole  String?
  vehicleId String?
  dealerId  String?
  details   Json?

  @@index([userId])
  @@index([vehicleId])
  @@index([action])
  @@index([timestamp])
}
