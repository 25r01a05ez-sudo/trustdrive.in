# Change this in any real deployment.
JWT_SECRET="trustdrive-dev-secret-change-me"

# --- Gmail OTP (email verification on login & signup) ---
# Required to send OTP emails. Use a Google "App Password" (NOT your Google
# account password). To create one:
#   1. Enable 2-Step Verification on your Google account.
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Create an app password for "Mail" — copy the 16-char code.
# Leave both blank for local dev — the OTP will be printed to the server
# console instead of emailed (look for "📬 [DEV] OTP for ..." in the logs).
# GMAIL_USER="your-app-email@gmail.com"
# GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Encrypts dealer KYC data (PAN, Aadhaar, bank details, document content) at
# rest -- required for any real deployment, since without it that data sits
# in your database as plain JSON. Generate one with:
#   openssl rand -base64 32
# Store this in your hosting provider's secret manager, not just in a .env
# file on one machine -- losing it makes existing encrypted data permanently
# unrecoverable. Leave unset for local dev only; a loud warning will print.
# ENCRYPTION_KEY="paste the output of openssl rand -base64 32 here"

# --- Database (optional) ---
# Leave unset to run against the built-in in-memory demo store (zero config,
# resets on restart). Set both to switch the backend to real Postgres via
# Prisma automatically -- no code changes needed. See README "Using Supabase"
# for exactly where to get these two values.
#
# DATABASE_URL = pooled connection (what the app uses at runtime)
# DIRECT_URL   = direct/unpooled connection (only used for migrations)
# For local Postgres (Docker), set both to the same value.
# DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:5432/postgres"

# --- WhatsApp dealer-registration alerts ---
# Your own WhatsApp number (with country code, digits only, e.g. 919876500000).
# Required for either mode below.
ADMIN_WHATSAPP_NUMBER="+917794013136"

# Optional -- only needed for messages to send automatically without anyone
# clicking a link. From Meta's WhatsApp Cloud API (free tier available):
# https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
# Leave both blank and the app falls back to a wa.me link the dealer/you can
# tap to send manually -- works immediately, no Meta setup required.
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""

# --- RC / VIN verification ---
# Optional -- leave both blank to use the built-in mock verifier (good for
# development). Set both to call a real government-vehicle-records API
# (e.g. a licensed VAHAN-data reseller like Surepass, Signzy, IDfy, or Setu).
# See backend/lib/rcVerification.js -- you may need to adjust the response
# parsing to match your chosen provider's exact API shape.
# RC_VERIFICATION_API_URL="https://api.yourprovider.com/v1/rc/verify"
# RC_VERIFICATION_API_KEY=""

# --- Dealer AI microsites (optional) ---
# Lets a verified dealer generate their own branded site on a subdomain
# (e.g. primemotors.trustdrive.in), from a text prompt.
# Supports either Google Gemini or Anthropic Claude:
GEMINI_API_KEY=""
# ANTHROPIC_API_KEY="sk-ant-..."

# The real domain this app will be deployed under, once you have one. Used
# by the frontend to detect dealer subdomains vs the main site. Leave unset
# for local dev -- see README "Dealer microsites" section for how to test
# subdomains on localhost.
# PUBLIC_DOMAIN="trustdrive.in"

PORT=4000
