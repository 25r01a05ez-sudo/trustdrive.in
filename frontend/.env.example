# Leave as /api to use the Vite dev proxy to localhost:4000.
VITE_API_BASE="/api"

# The real domain this app is deployed under (e.g. "trustdrive.in"), used to
# detect dealer subdomains vs the main site. Leave unset for local dev --
# the app treats "localhost" specially so you can test subdomains locally,
# see README "Dealer microsites" section.
# VITE_PUBLIC_DOMAIN="trustdrive.in"
